# Maven local. Copie para .env e preencha os valores da sua máquina.
# Inicie em backend/ com o perfil Spring local. Use valores sem aspas.
SPRING_DATASOURCE_URL=jdbc:sqlite:petcuidar-login-teste.db
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000

# Primeiro Admin e cookie para acesso local por HTTP.
AUTH_ADMIN_EMAIL=admin@petcuidar.local
AUTH_SECURE_COOKIE=false

# Mailpit local. A caixa de entrada abre em http://localhost:8025.
EMAIL_PROVIDER=smtp
EMAIL_FROM=acesso@petcuidar.local
RESEND_API_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
