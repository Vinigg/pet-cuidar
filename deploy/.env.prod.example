# Copie para deploy/.env.prod e ajuste. NUNCA commite o .env.prod.

# Origem publica do front (ex.: http://54.12.34.56 ou https://petcuidar.seudominio.com)
APP_CORS_ALLOWED_ORIGIN=http://SEU_IP_OU_DOMINIO

AGENDA_TIME_ZONE=America/Recife
LEMBRETE_TIME_ZONE=America/Recife

# IA: deixe em simulador/simulator ate ter chave real
IA_PROVIDER=simulator
LLM_PROVIDER=simulador
# LLM_API_KEY=

# E-mail: "local" so simula. Para envio real: resend + chave
EMAIL_PROVIDER=local
# RESEND_API_KEY=
# EMAIL_FROM=lembretes@seudominio.com

# So ligue depois de validar o provedor de e-mail real
LEMBRETE_JOB_ENABLED=false
